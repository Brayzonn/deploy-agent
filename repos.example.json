{
  "example-docker-api": {
    "name": "example-docker-api",
    "repo_dir": "/home/deploy/example-docker-api",
    "project_type": "DOCKER",
    "client_dir": "client",
    "server_dir": "server",
    "domain": "api.example.com",
    "port": 8000,
    "nginx_max_upload_mb": 5,
    "use_docker": true,
    "docker_compose_file": "docker-compose.prod.yml",
    "docker_env_file": ".env.production",
    "requires_migrations": true,
    "migration_command": "npm run db:migrate",
    "migration_service": "api",
    "infra_services": ["postgres", "redis"],
    "health_check_url": "http://localhost:8000/api/v1/health",
    "health_check_timeout": 30,
    "client_domain": "app.example.com",
    "client_web_root": "/var/www/html/example-docker-api"
  },
  "example-api-js": {
    "name": "example-api-js",
    "repo_dir": "/home/deploy/example-api-js",
    "web_root": "/var/www/html/example-api-js",
    "project_type": "API_JS",
    "client_dir": "client",
    "server_dir": "server",
    "server_entry": "app.js"
  },
  "example-api-ts": {
    "name": "example-api-ts",
    "repo_dir": "/home/deploy/example-api-ts",
    "web_root": "/var/www/html/example-api-ts",
    "project_type": "API_TS",
    "full_stack": true,
    "client_dir": "client",
    "server_dir": "server",
    "server_entry": "src/main.js",
    "pm2_ecosystem": "ecosystem.config.js"
  },
  "example-client": {
    "name": "example-client",
    "repo_dir": "/home/deploy/example-client",
    "web_root": "/var/www/html/example-client",
    "project_type": "CLIENT",
    "client_dir": ".",
    "domain": "www.example.com",
    "domain_aliases": ["example.com"]
  }
}
